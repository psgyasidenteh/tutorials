---
import '../styles/global.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Prince Sugar Gyasi-Denteh - Portfolio | Chemical Engineer | Process Simulation Specialist" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <div class="logo">
          <a href="/">PSG</a>
        </div>
        <ul class="nav-menu">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/about/" class="nav-link">About</a></li>
          <li><a href="/projects/" class="nav-link">Projects</a></li>
          <li><a href="/skills/" class="nav-link">Skills</a></li>
          <li><a href="/blog/" class="nav-link">Blog</a></li>
          <li><a href="/contact/" class="nav-link nav-cta">Contact</a></li>
        </ul>
      </div>
    </nav>

    <main class="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-content">
        <div class="footer-section">
          <h3>Prince Sugar Gyasi-Denteh</h3>
          <p>Chemical Engineer | Process Simulation Specialist</p>
        </div>
        <div class="footer-section">
          <h4>Contact</h4>
          <p><a href="tel:+233504511403">+233 504511403</a></p>
          <p><a href="mailto:psgyasi@gmail.com">psgyasi@gmail.com</a></p>
          <p>Apam, Ghana</p>
        </div>
        <div class="footer-section">
          <h4>Quick Links</h4>
          <p><a href="/">Home</a></p>
          <p><a href="/about/">About</a></p>
          <p><a href="/projects/">Projects</a></p>
          <p><a href="/skills/">Skills</a></p>
          <p><a href="/blog/">Blog</a></p>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Prince Sugar Gyasi-Denteh. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Navigation Styles */
  .navbar {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: var(--shadow-sm);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .nav-menu {
    display: flex;
    list-style: none;
    gap: var(--spacing-lg);
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
    font-size: var(--font-size-base);
  }

  .nav-link:hover {
    color: var(--color-primary);
  }

  .nav-cta {
    background-color: var(--color-primary);
    color: white;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-lg);
  }

  .nav-cta:hover {
    color: white;
    background-color: var(--color-secondary);
  }

  /* Main Content */
  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    min-height: calc(100vh - 300px);
  }

  /* Footer Styles */
  .footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    margin-top: var(--spacing-3xl);
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-3xl) var(--spacing-lg);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-2xl);
  }

  .footer-section h3,
  .footer-section h4 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .footer-section p {
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-sm);
  }

  .footer-section a {
    color: var(--color-primary);
  }

  .footer-bottom {
    text-align: center;
    padding: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  @media (max-width: 768px) {
    .nav-menu {
      gap: var(--spacing-md);
    }

    .nav-link {
      font-size: var(--font-size-sm);
    }

    .main-content {
      padding: var(--spacing-2xl) var(--spacing-md);
    }

    .footer-content {
      grid-template-columns: 1fr;
    }
  }
</style>

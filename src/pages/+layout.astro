---
import '../styles/global.css';
const title = Astro.props?.title ?? 'My Astro Site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro site" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/about/">About</a>
      <a href="/blog/">Blog</a>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; 2026 My Astro Site. All rights reserved.</p>
    </footer>
  </body>
</html>

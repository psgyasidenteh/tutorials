---
import Layout from '../layouts/Layout.astro';

export const title = 'Skills | Prince Sugar Gyasi-Denteh';
---

<Layout title={title}>
  <div class="skills-container">
    <h1>Technical Skills</h1>
    <p class="intro-text">A comprehensive overview of my professional expertise in chemical engineering, process simulation, and software development.</p>

    <div class="skills-grid">
      <!-- Process Software -->
      <div class="skill-category">
        <h2>Process Software</h2>
        <div class="skill-list">
          <span class="skill-tag">Aspen Plus</span>
          <span class="skill-tag">Aspen HYSYS</span>
          <span class="skill-tag">ChemSep-COCO Simulator</span>
        </div>
      </div>

      <!-- Programming Languages -->
      <div class="skill-category">
        <h2>Programming & Development</h2>
        <div class="skill-list">
          <span class="skill-tag">Python (DEAP, RDKit, PubChem, CAPE-OPEN)</span>
          <span class="skill-tag">MATLAB / Simulink</span>
          <span class="skill-tag">SQL</span>
        </div>
      </div>

      <!-- Engineering Tools -->
      <div class="skill-category">
        <h2>Engineering & Design Tools</h2>
        <div class="skill-list">
          <span class="skill-tag">AutoCAD 2D/3D</span>
          <span class="skill-tag">Microsoft Office Suite</span>
        </div>
      </div>

      <!-- Lab & Testing -->
      <div class="skill-category">
        <h2>Laboratory & Testing</h2>
        <div class="skill-list">
          <span class="skill-tag">Physicochemical Analysis</span>
          <span class="skill-tag">Microbial Testing</span>
          <span class="skill-tag">QA/QC Protocols</span>
          <span class="skill-tag">Dimensional Analysis</span>
        </div>
      </div>

      <!-- Other -->
      <div class="skill-category">
        <h2>Additional Skills</h2>
        <div class="skill-list">
          <span class="skill-tag">Typing: 70 WPM</span>
          <span class="skill-tag">Graphic Design</span>
        </div>
      </div>
    </div>

    <!-- Core Competencies -->
    <section class="competencies-section">
      <h2>Core Competencies</h2>
      <div class="competencies-grid">
        <div class="competency-card">
          <h3>Process Simulation & Modelling</h3>
          <p>Expert in using Aspen Plus for process design, thermodynamic calculations, and industrial process optimization</p>
        </div>
        <div class="competency-card">
          <h3>Molecular Design & Optimization</h3>
          <p>Experienced in computer-aided molecular design using evolutionary algorithms and machine learning for industrial applications</p>
        </div>
        <div class="competency-card">
          <h3>Quality Assurance & Testing</h3>
          <p>Proficient in physicochemical and microbial testing, ensuring compliance with food safety and quality standards</p>
        </div>
        <div class="competency-card">
          <h3>Problem Solving & Analysis</h3>
          <p>Strong analytical capabilities with demonstrated ability to identify deficiencies and develop targeted solutions</p>
        </div>
        <div class="competency-card">
          <h3>Industrial Operations</h3>
          <p>Hands-on experience in large-scale production environments with understanding of operational workflows and protocols</p>
        </div>
        <div class="competency-card">
          <h3>Technical Communication</h3>
          <p>Ability to document complex engineering solutions clearly and present findings to diverse audiences</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .intro-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-3xl);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--spacing-2xl);
    margin-bottom: var(--spacing-3xl);
  }

  .skill-category {
    background: var(--color-surface);
    padding: var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .skill-category h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-lg);
    color: var(--color-primary);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .skill-tag {
    display: inline-block;
    background-color: var(--color-primary);
    color: white;
    padding: var(--spacing-sm) var(--spacing-md);
    border-radius: var(--radius-lg);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .competencies-section {
    margin-top: var(--spacing-3xl);
  }

  .competencies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-xl);
  }

  .competency-card {
    background: var(--color-surface);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-primary);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .competency-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .competency-card h3 {
    color: var(--color-primary);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-md);
  }

  .competency-card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }
</style>

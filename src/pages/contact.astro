---
import Layout from '../layouts/Layout.astro';

export const title = 'Contact | Prince Sugar Gyasi-Denteh';
---

<Layout title={title}>
  <div class="contact-container">
    <h1>Get In Touch</h1>
    <p class="intro-text">Let's connect! Whether you're interested in collaborating, discussing engineering projects, or just want to chat, feel free to reach out.</p>

    <div class="contact-content">
      <!-- Contact Information -->
      <div class="contact-info-section">
        <h2>Contact Information</h2>
        <div class="contact-methods">
          <div class="contact-method">
            <h3>Phone</h3>
            <p><a href="tel:+233504511403">+233 504511403</a></p>
          </div>
          <div class="contact-method">
            <h3>Email</h3>
            <p><a href="mailto:psgyasi@gmail.com">psgyasi@gmail.com</a></p>
          </div>
          <div class="contact-method">
            <h3>Location</h3>
            <p>Apam, Ghana</p>
          </div>
          <div class="contact-method">
            <h3>💼 LinkedIn</h3>
            <p><a href="https://www.linkedin.com/in/prince-sugar-gyasi-denteh-b0910b289/" target="_blank">Prince Sugar Gyasi-Denteh</a></p>
          </div>
        </div>
    </div

      <!-- Quick Links -->
      <div class="quick-links-section">
        <h2>Quick Navigation</h2>
        <div class="quick-links">
          <a href="/about/" class="quick-link">
            <span>📄</span>
            <div>
              <h4>About Me</h4>
              <p>Learn more about my background and experience</p>
            </div>
          </a>
          <a href="/projects/" class="quick-link">
            <span>🚀</span>
            <div>
              <h4>Projects</h4>
              <p>Explore my academic and professional projects</p>
            </div>
          </a>
          <a href="/skills/" class="quick-link">
            <span>🛠️</span>
            <div>
              <h4>Skills</h4>
              <p>See my technical expertise and competencies</p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Message Section -->
    <section class="message-section">
      <h2>Send Me a Message</h2>
      <p>For inquiries or collaboration opportunities, please reach out via email and I'll get back to you as soon as possible.</p>
      <a href="mailto:psgyasi@gmail.com?subject=Inquiry%20from%20Portfolio&body=Hi%20Prince%2C%0A%0AI%20would%20like%20to%20discuss..." class="btn btn-primary" style="display: inline-block; margin-top: var(--spacing-lg);">Send Email</a>
    </section>
  </div>
</Layout>

<style>
  .contact-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .intro-text {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-3xl);
    text-align: center;
  }

  .contact-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: var(--spacing-3xl);
    margin-bottom: var(--spacing-3xl);
  }

  .contact-info-section h2,
  .quick-links-section h2 {
    color: var(--color-primary);
    margin-bottom: var(--spacing-xl);
  }

  .contact-methods {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--spacing-lg);
  }

  .contact-method {
    background: var(--color-surface);
    padding: var(--spacing-lg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .contact-method:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .contact-method h3 {
    color: var(--color-secondary);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-md);
  }

  .contact-method p {
    margin-bottom: 0;
  }

  .contact-method a {
    color: var(--color-primary);
  }

  .quick-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .quick-link {
    display: flex;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: all var(--transition-base);
    color: inherit;
    text-decoration: none;
  }

  .quick-link:hover {
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    box-shadow: var(--shadow-lg);
  }

  .quick-link span {
    font-size: var(--font-size-2xl);
    flex-shrink: 0;
  }

  .quick-link h4 {
    margin: 0 0 var(--spacing-sm) 0;
    color: inherit;
  }

  .quick-link p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: inherit;
  }

  .quick-link:hover h4,
  .quick-link:hover p {
    color: white;
  }

  .message-section {
    background: var(--color-surface);
    padding: var(--spacing-2xl) var(--spacing-xl);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-border);
    text-align: center;
  }

  .message-section h2 {
    color: var(--color-primary);
  }

  .message-section p {
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .contact-content {
      grid-template-columns: 1fr;
    }

    .contact-methods {
      grid-template-columns: 1fr;
    }
  }
</style>
